# Compose variables for docker/compose.yml.
# When deploying with Ansible this file is generated from group_vars — don't edit it on the server.
#
# NOTE: model provider API keys do NOT go here. Hermes keeps them in data/.env,
# written by the dashboard or `hermes setup` / `hermes model`.

# Public hostname of the dashboard (DNS A/AAAA record must point at the VPS).
HERMES_DOMAIN=hermes.example.com
ACME_EMAIL=you@example.com
# Uncomment while testing to use Let's Encrypt staging (untrusted certs, no rate limits):
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Pin to an exact release (e.g. v0.23.4) once things work; "stable" follows releases.
HERMES_VERSION=stable
TRAEFIK_VERSION=v3.6

# Hermes dashboard login (inner auth).
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me
# openssl rand -hex 32
DASHBOARD_SESSION_SECRET=change-me

TZ=UTC
