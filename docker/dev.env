# Compose variables for the local dev stack (compose.yml + compose.dev.yml).
# Safe to commit: dev-only values, nothing here is reachable from outside localhost.
# Used via `make dev` (passes --env-file docker/dev.env).

HERMES_DOMAIN=hermes.localhost
# Unused in dev (no ACME), but compose.yml requires it.
ACME_EMAIL=dev@example.invalid

HERMES_VERSION=stable
TRAEFIK_VERSION=v3.6

DASHBOARD_USERNAME=dev
DASHBOARD_PASSWORD=dev-password
DASHBOARD_SESSION_SECRET=dev-only-insecure-session-secret-0123456789abcdef

TZ=UTC
